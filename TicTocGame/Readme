    class Board {
        -char[][] cells OR Cell[][] cells
        -int size
        +Board(size)
        +isValidMove(row, col): boolean
        +placeMark(row, col, mark): void
        +getMark(row, col): char
        +isFull(): boolean
        +printBoard(): void
        +getSize(): int
    }

